# Public Supabase client configuration.
# These are safe to expose in the client bundle (never put service-role or other
# private keys in EXPO_PUBLIC_ variables).
#
# Copy this file to .env and fill in your project's values:
#   cp .env.example .env
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

{
  "expo": {
    "name": "Bitebook",
    "slug": "bitebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bitebook_brand_assets/generated/app-icon.png",
    "scheme": "bitebook",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E2F26",
    "ios": {
      "bundleIdentifier": "com.bitebook.app",
      "icon": {
        "light": "./assets/bitebook_brand_assets/generated/app-icon-light.png",
        "dark": "./assets/bitebook_brand_assets/generated/app-icon.png"
      }
    },
    "android": {
      "package": "com.bitebook.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E2F26",
        "foregroundImage": "./assets/bitebook_brand_assets/generated/adaptive-foreground.png",
        "monochromeImage": "./assets/bitebook_brand_assets/generated/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/bitebook_brand_assets/generated/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2F26",
          "image": "./assets/bitebook_brand_assets/generated/splash-symbol.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bitebook uses your location to recommend restaurants and dishes near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bitebook needs access to your photos so you can add a picture of the dish you logged.",
          "cameraPermission": "Bitebook needs access to your camera so you can photograph the dish you logged."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

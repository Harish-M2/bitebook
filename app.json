{
  "expo": {
    "name": "bitebook",
    "slug": "bitebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bitebook",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EFE9",
    "ios": {
      "bundleIdentifier": "com.bitebook.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.bitebook.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE9",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#0B0D0E",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bitebook uses your location to recommend restaurants and dishes near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bitebook needs access to your photos so you can add a picture of the dish you logged.",
          "cameraPermission": "Bitebook needs access to your camera so you can photograph the dish you logged."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
